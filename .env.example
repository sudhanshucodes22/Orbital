# Orbital — environment
#
# Copy to .env.local and fill in. Placeholders only: never commit real values.
# Every variable is read through lib/config/env.ts, so this is the complete
# list. Check what is live at GET /api/health.
#
# Nothing here is required to run the landing page.

# ---- public (inlined into the client bundle) ------------------------------
# Absolute origin. Drives Open Graph URLs and the canonical link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (server only) -----------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=
#
# The anon/publishable key. Supabase intends this to be publishable and Row
# Level Security is what protects the data, but Orbital runs all auth through
# Server Actions, so nothing in the browser needs it. It is kept server-side
# and deliberately NOT prefixed NEXT_PUBLIC_.
SUPABASE_ANON_KEY=
#
# Service role key. BYPASSES Row Level Security — treat as a root password.
# Used only to mint short-lived signed storage URLs. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=
#
# Storage bucket for uploaded sketches, screenshots, PDFs and audio.
# Created by supabase/migrations/0002_storage.sql.
STORAGE_BUCKET=orbital-artifacts

# ---- model provider (server only) ------------------------------------------
# All three are required together; any one missing leaves generation
# unconfigured. Resolved by lib/server/ai/registry.ts, which is the only file
# that maps configuration to a vendor adapter.
#
# No vendor adapter is registered yet, so setting these does not yet enable
# generation — the registry falls back to a provider that throws. Wiring one
# is a file under lib/server/ai/providers plus a line in that registry.

# anthropic | openai | google | custom
GENERATION_PROVIDER=
#
# The vendor's own model identifier, passed through verbatim.
GENERATION_MODEL=
#
# API key for the provider above. Server-side only; never NEXT_PUBLIC_.
GENERATION_API_KEY=

# ---- worker (server only) ---------------------------------------------------
# Shared secret for POST /api/worker/tick, which drains queued generations.
# Any scheduler that can make an HTTP call can drive it: Vercel Cron, a
# CronJob, GitHub Actions, or `npm run worker` in development.
#
# Without this the trigger refuses every request, so an unconfigured
# deployment fails closed rather than letting anyone drive the queue. Generate
# one with:  openssl rand -hex 32
WORKER_SECRET=
