# Orbital — environment
#
# Copy to .env.local for development. Every value below is read only through
# lib/config/env.ts; nothing reads process.env directly elsewhere, so this file
# is the complete list.
#
# Nothing here is required to run the landing page. Each variable enables one
# capability; until it is set, the corresponding route renders a notice saying
# so rather than inventing data. Check what is live at GET /api/health.

# ---- public (safe to expose; inlined into the client bundle) --------------
# Absolute origin. Drives Open Graph URLs and the canonical link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- server only (never prefixed NEXT_PUBLIC_) ----------------------------
# Enables: authentication, database, storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side privileged key. Must never appear in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, if used instead of the Supabase client.
DATABASE_URL=

# Object storage bucket for uploaded sketches, screenshots, PDFs and audio.
STORAGE_BUCKET=

# Enables: the generation engine.
GENERATION_API_KEY=
