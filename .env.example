# Orbital — environment
#
# Copy to .env.local and fill in. Placeholders only: never commit real values.
# Every variable is read through lib/config/env.ts, so this is the complete
# list. Check what is live at GET /api/health.
#
# Nothing here is required to run the landing page.

# ---- public (inlined into the client bundle) ------------------------------
# Absolute origin. Drives Open Graph URLs and the canonical link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (server only) -----------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=
#
# The anon/publishable key. Supabase intends this to be publishable and Row
# Level Security is what protects the data, but Orbital runs all auth through
# Server Actions, so nothing in the browser needs it. It is kept server-side
# and deliberately NOT prefixed NEXT_PUBLIC_.
SUPABASE_ANON_KEY=
#
# Service role key. BYPASSES Row Level Security — treat as a root password.
# Used only to mint short-lived signed storage URLs. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=
#
# Storage bucket for uploaded sketches, screenshots, PDFs and audio.
# Created by supabase/migrations/0002_storage.sql.
STORAGE_BUCKET=orbital-artifacts

# ---- not yet implemented ---------------------------------------------------
# Enables the generation engine. No engine is connected yet.
GENERATION_API_KEY=
